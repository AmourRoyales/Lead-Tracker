# MongoDB Atlas connection string and database name.
MONGODB_URI=
MONGODB_DB=lead_tracker

# Vertex AI (Gemini). Locally, auth is via `gcloud auth application-default
# login` (ADC) — no API key needed. "global" location matches the CAD Tools
# vertex_tag.py setup.
GOOGLE_CLOUD_PROJECT=gen-lang-client-0006684138
GOOGLE_CLOUD_LOCATION=global

# Only needed when deploying to a non-GCP host (Vercel, Railway, Render, ...),
# where there's no ADC to find. Paste the full service account key JSON here
# as one line. Leave blank for local dev and for Google Cloud hosts (Cloud
# Run, etc.) — those use ADC automatically.
GOOGLE_APPLICATION_CREDENTIALS_JSON=
