# MongoDB Atlas connection string and database name.
MONGODB_URI=
MONGODB_DB=lead_tracker

# --- Gemini access -----------------------------------------------------------
# Two ways to call Gemini:
#   api    -> Gemini Developer API using GEMINI_API_KEY below. Free tier is
#             ~1,500 requests/day. Nothing to authenticate beyond the key, so
#             this is what a deployed host should use.
#   vertex -> Vertex AI using Google Cloud credentials (local ADC, or a service
#             account key). No daily cap, but needs cloud credentials present.
# Leave GEMINI_MODE blank to get the defaults: API when deployed
# (NODE_ENV=production), Vertex when running locally. `npm run dev` asks which
# one you want and sets it for that session.
GEMINI_MODE=

# From https://aistudio.google.com/apikey — required when GEMINI_MODE=api,
# which is the default for deployed builds.
GEMINI_API_KEY=

# Optional model override. Defaults to gemini-3.5-flash-lite.
GEMINI_MODEL=

# --- Vertex AI (only used when GEMINI_MODE=vertex) ---------------------------
# Locally, auth is via `gcloud auth application-default login` (ADC) — no API
# key needed. "global" location matches the CAD Tools vertex_tag.py setup.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# Only needed to run Vertex mode on a non-GCP host (Vercel, Railway, Render,
# ...), where there's no ADC to find. Paste the full service account key JSON
# here as one line. Leave blank for local dev, for Google Cloud hosts (Cloud
# Run, etc.), and when using GEMINI_MODE=api.
GOOGLE_APPLICATION_CREDENTIALS_JSON=
